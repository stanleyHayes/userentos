# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it is already in .gitignore.

# Production runs against the `rentos_production` database. Point local demo
# work at a different database name (e.g. .../rentos_dev) so the demo seed can
# never write fake data into the live one.
MONGO_URI=mongodb://localhost:27017/rentos_production
PORT=3002
JWT_SECRET=change-me-to-a-long-random-string

# Anthropic (AI Legal Assistant)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Resend (Email). Required for invitation emails — without a valid key the
# invite is still created, but the inviter has to share the link by hand.
RESEND_API_KEY=re_...
FROM_EMAIL=onboarding@resend.dev

# Base URL of the web app. Every emailed link (invitations, password resets,
# receipts) is built from this — set it to the deployed site in production.
PUBLIC_BASE_URL=http://localhost:5173

# Twilio (SMS)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1234567890

# Cloudinary (Image & Document Storage)
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# Firebase (Push Notifications)
# Provide the path to a service-account JSON file, or inline the JSON object.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Payment provider mode: 'simulated' | 'mtn_momo' | 'telecel_cash' | 'airteltigo_money'
PAYMENTS_PROVIDER_MODE=simulated

# Redis (optional — falls back to in-memory cache)
REDIS_URL=

# External ML Pricing Service (optional — falls back to local TypeScript model)
# ML_SERVICE_URL=http://localhost:8000
# Shared secret with the ML service — MUST be set in any exposed deployment.
# The ML service rejects unauthenticated calls when this is configured on both sides.
ML_API_KEY=

# Owner super-admin. Required by `npm run seed:production`, which plants this
# single account plus reference data (plans, laws, blog, flags, insurance) and
# nothing else. Optional for the demo seed (leave empty there to skip).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=Owner
SEED_ADMIN_LAST_NAME=Admin
SEED_ADMIN_PHONE=0300000000

# Demo seed (18 fake users, 180 properties, fake payments/disputes).
# 'false' blocks it in every environment — always use false against
# rentos_production. 'true' forces it, even when NODE_ENV=production.
SEED_DEMO=false

# Set to 'true' to expose /api/docs (Swagger UI) in production
ENABLE_API_DOCS=false

# Docker Compose MongoDB credentials (required for docker compose up)
MONGO_ROOT_USERNAME=rentos
MONGO_ROOT_PASSWORD=change-me

# Node environment
NODE_ENV=development

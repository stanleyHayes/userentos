{
  "name": "@rentos/query-string-compat",
  "version": "1.0.0",
  "private": true,
  "description": "Export-shape compatibility for navigation using patched upstream query-string",
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.mjs", "require": "./index.cjs" }
  },
  "engines": { "node": ">=20.19.0" },
  "dependencies": { "query-string-modern": "npm:query-string@9.5.1" }
}

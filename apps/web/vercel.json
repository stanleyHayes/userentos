{
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/property/:ref",
      "missing": [
        {
          "type": "query",
          "key": "_shell"
        }
      ],
      "destination": "/api/page?path=/property/:ref"
    },
    {
      "source": "/registry/:id",
      "missing": [
        {
          "type": "query",
          "key": "_shell"
        }
      ],
      "destination": "/api/page?path=/registry/:id"
    },
    {
      "source": "/article/:slug",
      "missing": [
        {
          "type": "query",
          "key": "_shell"
        }
      ],
      "destination": "/api/page?path=/article/:slug"
    },
    {
      "source": "/s/:path*",
      "missing": [
        {
          "type": "query",
          "key": "_shell"
        }
      ],
      "destination": "/api/page?path=/s/:path*"
    },
    {
      "source": "/:page(registry|blog|rental-laws|developments|support|register|privacy|terms|data-protection)",
      "missing": [
        {
          "type": "query",
          "key": "_shell"
        }
      ],
      "destination": "/api/page?path=/:page"
    },
    {
      "source": "/",
      "missing": [
        {
          "type": "query",
          "key": "_shell"
        }
      ],
      "destination": "/api/page?path=/"
    },
    {
      "source": "/:purpose(rent|buy|short-stay)",
      "missing": [
        {
          "type": "query",
          "key": "_shell"
        }
      ],
      "destination": "/api/page?path=/:purpose"
    },
    {
      "source": "/:purpose(rent|buy|short-stay)/:path*",
      "missing": [
        {
          "type": "query",
          "key": "_shell"
        }
      ],
      "destination": "/api/page?path=/:purpose/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "[a-z0-9-]+\\.userentos\\.com"
        }
      ],
      "missing": [
        {
          "type": "host",
          "value": "(www|api)\\.userentos\\.com"
        },
        {
          "type": "query",
          "key": "_shell"
        }
      ],
      "destination": "/api/page?path=/:path*"
    },
    {
      "source": "/:path*",
      "missing": [
        {
          "type": "host",
          "value": "(.+\\.)?userentos\\.com"
        },
        {
          "type": "host",
          "value": ".+\\.vercel\\.app"
        },
        {
          "type": "host",
          "value": "localhost(:\\d+)?"
        },
        {
          "type": "query",
          "key": "_shell"
        }
      ],
      "destination": "/api/page?path=/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

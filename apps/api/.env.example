# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it is already in .gitignore.

# Production runs against the `rentos_production` database. Point local demo
# work at a different database name (e.g. .../rentos_dev) so the demo seed can
# never write fake data into the live one.
MONGO_URI=mongodb://localhost:27017/rentos_production
PORT=3002
JWT_SECRET=change-me-to-a-long-random-string

# Anthropic (AI Legal Assistant)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Resend (Email). Required for invitation emails — without a valid key the
# invite is still created, but the inviter has to share the link by hand.
RESEND_API_KEY=re_...
FROM_EMAIL=onboarding@resend.dev

# Base URL of the web app. Every emailed link (invitations, password resets,
# receipts) is built from this — set it to the deployed site in production.
PUBLIC_BASE_URL=http://localhost:5280

# Public URL of the API — payment providers POST confirmations here.
# Separate from PUBLIC_BASE_URL on purpose: emails need the web app,
# provider callbacks need the API. Pointed at the web app, a callback hits
# the SPA, which answers 200 with HTML, so the provider records a
# successful delivery and the payment silently never completes.
# Blank falls back to PUBLIC_BASE_URL, for a single-origin deployment.
PUBLIC_API_URL=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1234567890

# Cloudinary (Image & Document Storage)
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# Firebase (Push Notifications)
# Provide the path to a service-account JSON file, or inline the JSON object.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# ─── Payments ───
# 'simulated' fakes every collection (no money moves); 'live' uses the real
# adapters below. Which adapter runs is chosen per payment method, not here.
# Unset + NODE_ENV=production is a hard startup error, by design. So is
# 'simulated' in production unless ALLOW_SIMULATED_PAYMENTS=true, which only a
# staging or demo deployment should ever set.
PAYMENTS_PROVIDER_MODE=simulated
ALLOW_SIMULATED_PAYMENTS=

# ─── Personal data encryption ───
# 64 hex characters (32 bytes) used to encrypt Ghana Card / national ID numbers
# at rest (AES-256-GCM). Required in production; the API will not start
# without it. Generate with: openssl rand -hex 32. Keep it in a secret manager;
# losing it makes stored ID numbers unreadable. After first setting it, run
# npx tsx --env-file=.env src/scripts/encryptPiiFields.ts to encrypt old rows.
PII_ENCRYPTION_KEY=

# Keys the daily-rotating hashes used to count unique visitors to public
# registry and storefront pages. Any long random value (openssl rand -hex 32).
# Unset: a development key from this repository is used, and a production boot
# logs a warning because those hashes could then be reversed.
VISITOR_HASH_SECRET=

# ─── Regulated features (Ghana) ───
# Comma-separated features to offer: rent_collection, wallet, lending,
# financing, investments, insurance, payroll, credit_reporting. Unset means all
# in development/test and NONE in production. Each feature enabled in
# production also needs REGULATED_BASIS_<FEATURE> recording the licence number or
# licensed partner agreement relied on (e.g. REGULATED_BASIS_RENT_COLLECTION=
# "Paystack split settlement, merchant agreement ref ..."), or the API will not
# start. Enabling one in the mobile app store build also needs a store update
# that discloses the feature. See docs/compliance/regulated-features.md.
REGULATED_FEATURES=
REGULATED_BASIS_RENT_COLLECTION=
REGULATED_BASIS_WALLET=
REGULATED_BASIS_LENDING=
REGULATED_BASIS_FINANCING=
REGULATED_BASIS_INVESTMENTS=
REGULATED_BASIS_INSURANCE=
REGULATED_BASIS_PAYROLL=
REGULATED_BASIS_CREDIT_REPORTING=

# MTN Mobile Money — Collections. BASE_URL defaults to the sandbox host, so it
# must be set for live. TARGET_ENV is 'mtnghana' in production.
# CALLBACK_URL is your public webhook: https://<api-host>/api/payments/webhook/mtn_momo
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_BASE_URL=
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_CALLBACK_URL=

# Telecel Cash (ex-Vodafone Cash) — adapter is a structural stub; confirm the
# endpoint paths against Telecel's current spec before going live.
TELECEL_CLIENT_ID=
TELECEL_CLIENT_SECRET=
TELECEL_BASE_URL=
TELECEL_WEBHOOK_SECRET=

# AirtelTigo Money — adapter is a structural stub; re-validate endpoints and
# the signature header name against the operator spec before going live.
AIRTELTIGO_CLIENT_ID=
AIRTELTIGO_CLIENT_SECRET=
AIRTELTIGO_BASE_URL=
AIRTELTIGO_WEBHOOK_SECRET=

# Bank transfer rail — the account tenants deposit into (shown in the payment
# instructions) and the HMAC secret your PSP signs webhooks with. Unset falls
# back to a placeholder account number.
BANK_DEPOSIT_ACCOUNT=
BANK_DEPOSIT_BANK_NAME=
BANK_PSP_WEBHOOK_SECRET=

# ─── Payouts (money out) ───
# Which PSP sends payouts when PAYMENTS_PROVIDER_MODE=live. Anything else and
# payouts run through the in-process simulator (no real money).
PAYOUT_PROVIDER=paystack
# Paystack secret key (sk_test_... / sk_live_...). Also the key webhook
# signatures are verified against, so there is no separate webhook secret.
PAYSTACK_SECRET_KEY=
# Override only for testing against a mock; defaults to https://api.paystack.co
PAYSTACK_BASE_URL=

# ─── Lending (defaults shown) ───
LOAN_INTEREST_RATE=15
LOAN_PROCESSING_FEE_PCT=0
LOAN_MIN_CREDIT_SCORE=50
# Scores at or above this are pre-qualified (still reviewed by a lender, never auto-approved)
LOAN_PREQUALIFY_SCORE=70

# Financier offer caps (terms are always at least 3 months)
FINANCING_MAX_ANNUAL_RATE=60
FINANCING_MAX_PROCESSING_FEE_PCT=10
FINANCING_MAX_OFFER_AMOUNT=200000

# ─── Insurance ───
# Fictional demo insurance products are seeded/sold only outside production.
# Set true to allow them on a NODE_ENV=production staging box; never on live.
INSURANCE_DEMO_SEED=

# ─── Infrastructure ───
# Redis (optional — falls back to an in-memory, per-instance cache)
REDIS_URL=

# Comma-separated browser origins allowed to call the API. Empty is fine in dev
# (localhost is always allowed); production must list the real web origins.
CORS_ALLOWED_ORIGINS=

# Sentry error tracking (optional — unset disables it)
SENTRY_DSN=
SENTRY_RELEASE=

# winston log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# ─── AI / ML ───
# Model override for the AI legal assistant (defaults to claude-sonnet-4-20250514)
# AI JSON calls use a 30-second header/body deadline, 16 MiB response cap, and no automatic SDK retries.
# Only api.anthropic.com and api.openai.com are allowed; custom base-URL proxies are not supported.
ANTHROPIC_MODEL=

# Used ONLY for legal-document search embeddings. Unset disables that search.
OPENAI_API_KEY=

# External ML Pricing Service (optional — falls back to local TypeScript model)
ML_SERVICE_URL=
# Shared secret with the ML service — MUST be set in any exposed deployment.
# The ML service rejects unauthenticated calls when this is configured on both sides.
ML_API_KEY=

# ─── Baseten (hosted ML models) ─── optional
# Paste your Baseten API key here. Unset = Baseten is not used and the pricing
# model falls back to ML_SERVICE_URL, then to the local TypeScript model.
BASETEN_API_KEY=
# The deployed model's id, from the Baseten dashboard (e.g. abcd1234).
BASETEN_MODEL_ID=
# Optional: paste the full predict URL from the dashboard instead, if your
# deployment does not follow the default model-<id>.api.baseten.co pattern.
BASETEN_MODEL_URL=
# Which deployment environment to call. Defaults to production.
BASETEN_ENVIRONMENT=production

# Owner super-admin. Required by `npm run seed:production`, which plants this
# single account plus reference data (plans, laws, blog, flags, insurance) and
# nothing else. Optional for the demo seed (leave empty there to skip).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=Owner
SEED_ADMIN_LAST_NAME=Admin
SEED_ADMIN_PHONE=0300000000

# Demo seed (18 fake users, 180 properties, fake payments/disputes).
# 'false' blocks it in every environment — always use false against
# rentos_production. 'true' forces it, even when NODE_ENV=production.
SEED_DEMO=false

# Set to 'true' to expose /api/docs (Swagger UI) in production
ENABLE_API_DOCS=false

# Docker Compose MongoDB credentials (required for docker compose up)
MONGO_ROOT_USERNAME=rentos
MONGO_ROOT_PASSWORD=change-me

# Node environment
NODE_ENV=development

# ─── Hosting / TLS for storefront custom domains (spec §4.3) ───
# Without these, verifying a custom domain still works but TLS is reported as
# "not managed by this deployment" instead of sitting at "provisioning" forever.
# HOSTING_PROVIDER: "vercel" (default) or "none" to disable provisioning.
HOSTING_PROVIDER=vercel
# A Vercel access token with access to the web project.
VERCEL_API_TOKEN=
# The web project's ID (Vercel dashboard → Project → Settings → Project ID).
VERCEL_PROJECT_ID=
# Only if the project belongs to a team rather than a personal account.
VERCEL_TEAM_ID=
# How long a certificate may stay pending before it is reported as failed.
TLS_PROVISION_TIMEOUT_HOURS=24

# Which rail carries a LIVE mobile-money collection for rent/savings/subscriptions:
#   paystack (default) — one relationship, fronts MTN, Telecel and AirtelTigo
#   direct            — the per-telco integrations, each needing its own contract
# Bank transfer always uses its own adapter regardless of this setting.
PAYMENTS_RAIL=paystack
# Receipt address Paystack requires on a charge. Not used for anything else.
PAYSTACK_COLLECTION_EMAIL=payments@userentos.com

# Google Play server verification (service account must have Play Console access).
# Keep the JSON credential outside the repository; this path is server-only.
GOOGLE_PLAY_PACKAGE_NAME=gh.rentos.mobile
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
# Test purchases are always rejected when NODE_ENV=production, even if true.
GOOGLE_PLAY_ALLOW_TEST_PURCHASES=false
# Authenticated Pub/Sub push for /api/webhooks/google-play. Exact configured
# audience, push service-account email and full subscription resource name.
GOOGLE_PLAY_PUBSUB_AUDIENCE=
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_PUBSUB_SUBSCRIPTION=

# 32 random bytes encoded as 64 hex characters; no fallback to JWT secrets.
# Retain this key securely for existing encrypted purchase tokens.
STORE_BILLING_ENCRYPTION_KEY=

# Apple App Store Server API + signed transaction verification. Files must be
# server-owned and outside the repository; root certificates come from Apple PKI.
APPLE_STORE_BUNDLE_ID=gh.rentos.mobile
APPLE_STORE_APP_ID=
APPLE_STORE_KEY_ID=
APPLE_STORE_ISSUER_ID=
APPLE_STORE_PRIVATE_KEY_FILE=
# Explicit Production or Sandbox. Sandbox is rejected when NODE_ENV=production.
APPLE_STORE_ENVIRONMENT=Production
# JSON array of local Apple root CA certificate paths (DER or PEM).
APPLE_STORE_ROOT_CA_FILES=[]

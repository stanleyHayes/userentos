# E2E test environment — copied over .env values but points at local MongoDB.
# Usage: cp .env.e2e .env   (or load via env vars in scripts)

# 28018 is the RentOS dev MongoDB container (rentos-dev-mongo). It was 27017,
# where nothing of ours listens — so whenever Playwright started its own
# server this URI could not connect at all, and the suite only ever ran by
# reusing a dev server that happened to be up, against the dev database.
# 27017 is also the default port other projects' containers claim, so a
# neighbouring container answering here would be worse than nothing.
MONGO_URI=mongodb://localhost:28018/rentos_e2e
# Clear of the dev API on 3002, so an e2e run and a dev session coexist.
PORT=3402
JWT_SECRET=e2e-test-secret-do-not-use-in-production
PAYMENTS_PROVIDER_MODE=simulated
NODE_ENV=development

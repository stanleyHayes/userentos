# API base URL (include the /api path).
# Dev:        http://localhost:3002/api
# Production: https://api.userentos.com/api
#
# MUST be https in production. The site is served over https, and a browser
# blocks an https page from calling an http endpoint as mixed content — every
# request would fail before it left the page.
VITE_API_URL=http://localhost:3002/api

# WebSocket server URL (no /api suffix). Same https requirement — an https page
# can only open a wss:// socket.
# Production: https://api.userentos.com
VITE_SOCKET_URL=http://localhost:3002

# Canonical public site URL, used at build time for og:image, og:url, canonical,
# robots.txt and sitemap.xml. Defaults to https://userentos.com.
VITE_SITE_URL=

# Sentry (Error Tracking) — leave unset in dev to disable
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
# Web push (VAPID public key) — must match the key pair the server signs with.
# Unset disables browser push subscription.
VITE_VAPID_PUBLIC_KEY=
